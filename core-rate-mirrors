set -euo pipefail

readonly MIRRORS_DEFAULT_DIR="/etc/pacman.d"
readonly TMPFILE="$(mktemp)"

trap 'rm -f "$TMPFILE"' EXIT

# Use HTTPS only
export RATE_MIRRORS_PROTOCOL=https
export RATE_MIRRORS_ALLOW_ROOT=true
export RATE_MIRRORS_FETCH_MIRRORS_TIMEOUT="${RATE_MIRRORS_FETCH_MIRRORS_TIMEOUT:-30000}"
export RATE_MIRRORS_MAX_DELAY="${RATE_MIRRORS_MAX_DELAY:-10000}"

if ((EUID != 0)); then
  echo "Error: run as root" >&2
  exit 1
fi

if ! command -v rate-mirrors >/dev/null 2>&1; then
  echo "Error: rate-mirrors is not installed" >&2
  exit 1
fi

echo "==> Ranking Arch Linux mirrors..."

if rate-mirrors \
  --allow-root \
  --save "$TMPFILE" \
  --top-mirrors-number 10 \
  arch; then

  install -m644 \
    --backup=simple \
    --suffix="-backup" \
    "$TMPFILE" \
    "${MIRRORS_DEFAULT_DIR}/mirrorlist"

  echo "==> Done: ${MIRRORS_DEFAULT_DIR}/mirrorlist"
else
  echo "Error: failed to rank mirrors" >&2
  exit 1
fi
